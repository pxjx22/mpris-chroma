[Unit]
Description=Sync wlchroma background colors to MPRIS album art
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
# install.sh puts the binary in ~/.local/bin. Assumes wlchroma is cloned at
# ~/wlchroma; adjust WLCHROMA_CTL if your layout differs.
Environment=WLCHROMA_CTL=%h/wlchroma/zig-out/bin/wlchroma-ctl
ExecStart=%h/.local/bin/mpris-chroma
Restart=on-failure
RestartSec=3

# SEC-014: sandbox the process. Only ~/.cache/mpris-chroma is writable; the
# binary, wlchroma binary/config, and Jellyfin covers are read under
# ProtectHome=read-only. AF_UNIX covers the D-Bus session bus and the
# wlchroma-ctl socket (%t/wlchroma.sock); AF_INET(6) covers Spotify CDN HTTPS.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.cache/mpris-chroma
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
UMask=0077
MemoryMax=256M
TasksMax=32
TimeoutStopSec=30

[Install]
WantedBy=graphical-session.target
